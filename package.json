{
  "name": "cloudflare-workers-template",
  "version": "1.1.0",
  "description": "Boilerplate template for Cloudflare Workers projects",
  "private": true,
  "keywords": [
    "cloudflare",
    "workers",
    "wrangler",
    "template",
    "boilerplate"
  ],
  "author": "Matt Bakaitis <matt@bakaitis.com>",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run && npm run test:contracts",
    "test:contracts": "node --test test/contracts/*.test.js",
    "test:watch": "vitest",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "version": "changeset version",
    "release": "changeset tag",
    "deploy:non-prod": "wrangler deploy --env non-prod",
    "deploy:production": "wrangler deploy --env production"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@cloudflare/vitest-plugin": "1.4.7",
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "eslint": "10.13.0",
    "vitest": "5.0.5",
    "wrangler": "4.152.0"
  }
}