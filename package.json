{
  "name": "cloudflare-workers-template",
  "version": "0.1.0",
  "description": "Forkable boilerplate for Cloudflare Workers projects",
  "private": true,
  "keywords": [
    "cloudflare",
    "workers",
    "wrangler",
    "template",
    "boilerplate"
  ],
  "author": "Matt Bakaitis <matt@bakaitis.com>",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run && npm run test:contracts",
    "test:contracts": "node --test test/contracts/*.test.js",
    "test:watch": "vitest",
    "deploy:non-prod": "wrangler deploy --env non-prod",
    "deploy:production": "wrangler deploy --env production"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint": "^10.8.1",
    "vitest": "^4.1.11",
    "wrangler": "^4.124.0"
  }
}
